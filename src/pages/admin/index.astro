---
import AdminLayout from '../../layouts/AdminLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { getAnalytics } from '../../lib/supabase';

// Count content files
const countFiles = (folder: string) => {
  try {
    const dir = path.join(process.cwd(), `content/${folder}`);
    if (!fs.existsSync(dir)) return 0;
    return fs.readdirSync(dir).filter(f => f.endsWith('.yaml')).length;
  } catch (e) {
    return 0;
  }
};

const unitCount = countFiles('units');
const testimonialCount = countFiles('testimonials');
const faqCount = countFiles('faqs');

// Get analytics
const clientId = import.meta.env.PUBLIC_CLIENT_ID || 'template-001';
const analytics = await getAnalytics(clientId);
---

<AdminLayout title="Dashboard">
  <!-- Header -->
  <div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-xl font-bold text-gray-900 tracking-tight">Dashboard Overview</h1>
        <p class="text-sm text-gray-500 mt-0.5">Pantau performa dan kelola konten website.</p>
    </div>
    <div class="hidden md:flex items-center gap-2 text-xs font-medium bg-white px-3 py-1.5 rounded-full border border-gray-200 shadow-sm text-gray-600">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        System Active
    </div>
  </div>

  <!-- Analytics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
    <!-- Total Visitors -->
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm relative overflow-hidden group">
      <div class="absolute right-0 top-0 w-24 h-24 bg-blue-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
      
      <div class="relative z-10 flex flex-col justify-between h-full">
        <div class="flex items-center gap-3 mb-2 text-blue-600">
            <div class="p-2 bg-blue-100 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <span class="text-sm font-semibold tracking-wide uppercase text-blue-900/60">Total Pengunjung</span>
        </div>
        <div>
            <div class="text-3xl font-extrabold text-gray-900 tracking-tight">{analytics.totalViews.toLocaleString()}</div>
            <div class="text-xs text-gray-500 mt-1">Sejak website aktif</div>
        </div>
      </div>
    </div>

    <!-- Today's Visitors -->
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm relative overflow-hidden group">
      <div class="absolute right-0 top-0 w-24 h-24 bg-emerald-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>

      <div class="relative z-10 flex flex-col justify-between h-full">
         <div class="flex items-center gap-3 mb-2 text-emerald-600">
             <div class="p-2 bg-emerald-100 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
             </div>
             <span class="text-sm font-semibold tracking-wide uppercase text-emerald-900/60">Hari Ini</span>
         </div>
         <div>
            <div class="text-3xl font-extrabold text-gray-900 tracking-tight flex items-baseline gap-2">
                {analytics.todayViews.toLocaleString()}
                <span class="text-sm font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Active</span>
            </div>
            <div class="text-xs text-gray-500 mt-1">Kunjungan dalam 24 jam</div>
         </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Content Management -->
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                <h2 class="font-semibold text-gray-900 flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                    Database Konten
                </h2>
                <a href="/admin/collection/units" class="text-xs font-medium text-blue-600 hover:text-blue-700 hover:underline">Lihat Semua</a>
            </div>
            
            <div class="divide-y divide-gray-100">
                <!-- Unit Item -->
                <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors group">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-all">
                             <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-gray-900">Unit Rumah</div>
                            <div class="text-xs text-gray-500">{unitCount} tipe perumahan terdaftar</div>
                        </div>
                    </div>
                    <a href="/admin/collection/units" class="p-2 text-gray-300 hover:text-indigo-600 hover:bg-indigo-50 rounded-full transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>

                <!-- Testimonial Item -->
                <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors group">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center group-hover:bg-amber-600 group-hover:text-white transition-all">
                             <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-gray-900">Testimoni Klien</div>
                            <div class="text-xs text-gray-500">{testimonialCount} ulasan ditampilkan</div>
                        </div>
                    </div>
                    <a href="/admin/collection/testimonials" class="p-2 text-gray-300 hover:text-amber-600 hover:bg-amber-50 rounded-full transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>

                <!-- FAQ Item -->
                <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors group">
                    <div class="flex items-center gap-4">
                         <div class="w-10 h-10 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center group-hover:bg-teal-600 group-hover:text-white transition-all">
                             <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-gray-900">Pertanyaan (FAQ)</div>
                            <div class="text-xs text-gray-500">{faqCount} pertanyaan umum</div>
                        </div>
                    </div>
                    <a href="/admin/collection/faqs" class="p-2 text-gray-300 hover:text-teal-600 hover:bg-teal-50 rounded-full transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>
        </div>
      </div>

      <!-- Quick Actions (Side Panel) -->
      <div class="space-y-6">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <h2 class="font-semibold text-gray-900 flex items-center gap-2 mb-4">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                Aksi Cepat
            </h2>
            
            <div class="space-y-3">
                 <a href="/admin/collection/units/create" class="flex items-center w-full p-3 rounded-lg border border-gray-200 hover:border-blue-500 hover:ring-1 hover:ring-blue-500 hover:bg-blue-50 transition-all group bg-gray-50/50">
                    <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-blue-600 mr-3 shadow-sm group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    </div>
                    <div class="text-left">
                        <div class="text-sm font-medium text-gray-900 group-hover:text-blue-700">Tambah Unit</div>
                    </div>
                 </a>

                 <a href="/admin/collection/testimonials/create" class="flex items-center w-full p-3 rounded-lg border border-gray-200 hover:border-amber-500 hover:ring-1 hover:ring-amber-500 hover:bg-amber-50 transition-all group bg-gray-50/50">
                    <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-amber-600 mr-3 shadow-sm group-hover:bg-amber-600 group-hover:text-white group-hover:border-amber-600 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    </div>
                    <div class="text-left">
                        <div class="text-sm font-medium text-gray-900 group-hover:text-amber-700">Tambah Testimoni</div>
                    </div>
                 </a>

                 <a href="/" target="_blank" class="flex items-center w-full p-3 rounded-lg border border-gray-200 hover:border-gray-500 hover:ring-1 hover:ring-gray-500 hover:bg-gray-50 transition-all group mt-4">
                    <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-600 mr-3 shadow-sm group-hover:bg-gray-800 group-hover:text-white group-hover:border-gray-800 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </div>
                    <div class="text-left">
                        <div class="text-sm font-medium text-gray-900">Lihat Website Live</div>
                    </div>
                 </a>
            </div>
        </div>

        <!-- Help Card -->
         <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl p-5 text-white shadow-lg">
            <h3 class="font-bold text-lg mb-1">Butuh Bantuan?</h3>
            <p class="text-indigo-100 text-sm mb-4">Hubungi support jika mengalami kendala teknis.</p>
            <a href="https://wa.me/6281234567890" target="_blank" class="block w-full text-center py-2 bg-white/20 hover:bg-white/30 backdrop-blur rounded-lg text-sm font-medium transition-colors border border-white/30">
                Chat WhatsApp Support
            </a>
         </div>
      </div>
  </div>

</AdminLayout>
