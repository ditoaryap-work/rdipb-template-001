---
import { siteConfig } from '../../config/site.config';
import { getContent } from '../../lib/content';

const heroData = getContent('sections/hero');
const slides = heroData?.slides || [
  {
    image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2000&auto=format&fit=crop",
    title: "Data Hero Tidak Ditemukan",
    subtitle: "System Error", 
    tagline: "Silakan cek file content/sections/hero.yaml",
    features: ["Error Loading Data"]
  }
];
---

<section id="home" class="relative min-h-[100svh] lg:min-h-screen flex flex-col lg:flex-row bg-[#0a0a0a] overflow-hidden font-sans">
  
  <!-- LEFT SIDE: Content (Desktop: Left / Mobile: TOP) -->
  <div class="relative z-20 w-full lg:w-[50%] flex flex-col justify-center px-6 md:px-12 lg:px-16 pt-24 pb-8 lg:pt-24 lg:pb-8 xl:pt-28 xl:pb-12 bg-gradient-to-br from-[#18181b] to-[#27272a] border-r border-white/5 order-1 lg:order-1 flex-shrink-0">
    
    <!-- Decorative Element -->
    <div class="absolute top-0 left-0 w-64 h-64 bg-emerald-500/10 blur-[120px] rounded-full -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>

    <div class="relative space-y-4 xl:space-y-6 max-w-xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-black uppercase tracking-[0.2em] w-fit">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Premium Real Estate
      </div>

      <!-- Main Headline -->
      <div class="space-y-2 lg:space-y-3 xl:space-y-4">
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black text-white leading-[1.1] drop-shadow-2xl" id="hero-title">
          {slides[0].title}
        </h1>
        <p class="text-gray-300 text-sm md:text-lg xl:text-xl leading-relaxed font-normal opacity-90 line-clamp-2 md:line-clamp-none" id="hero-tagline">
          {slides[0].tagline}
        </p>
      </div>

      <!-- Features Checklist (Desktop/Tablet) -->
      <div class="hidden sm:grid grid-cols-1 gap-2 xl:gap-3 pt-1 xl:pt-2" id="hero-features">
        {slides[0].features.map((feature) => (
          <div class="flex items-center gap-3 text-gray-200">
            <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center">
              <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm font-medium tracking-wide">{feature}</span>
          </div>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row sm:gap-4 gap-4 pt-1 xl:pt-2 lg:mb-4 xl:mb-6">
        <a 
          href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo, saya ingin konsultasi tentang unit di Grand Avenue`}
          target="_blank"
          class="group relative inline-flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-8 py-3 rounded-full transition-all duration-300 shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] active:scale-95 text-sm md:text-base flex-1 sm:flex-none"
          id="hero-whatsapp-btn"
        >
          <svg class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Konsultasi Sekarang
        </a>
        <a 
          href="#catalog"
          class="inline-flex items-center justify-center gap- px-8 py-3 rounded-full border border-white/20 text-white font-bold hover:bg-white/10 transition-all duration-300 backdrop-blur-sm text-sm md:text-base flex-1 sm:flex-none"
        >
          Lihat Unit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
      </div>
    </div>

    <!-- Bottom Stats (Desktop/Mobile) -->
    <div class="mt-8 lg:mt-auto border-t border-white/10 grid grid-cols-3 gap-4 pt-4 xl:pt-6 w-full">
      <div class="flex flex-col gap-1 items-center lg:items-start text-center lg:text-left">
        <div class="text-xl lg:text-3xl xl:text-4xl font-black text-white">0%</div>
        <div class="text-[9px] lg:text-[10px] text-gray-500 uppercase tracking-[0.1em] lg:tracking-[0.2em] font-black leading-none">Bunga</div>
      </div>
      <div class="flex flex-col gap-1 items-center lg:items-start text-center lg:text-left border-l border-white/5 lg:border-none pl-4 lg:pl-0">
        <div class="text-xl lg:text-3xl xl:text-4xl font-black text-white">24hr</div>
        <div class="text-[9px] lg:text-[10px] text-gray-500 uppercase tracking-[0.1em] lg:tracking-[0.2em] font-black leading-none">Keamanan</div>
      </div>
      <div class="flex flex-col gap-1 items-center lg:items-start text-center lg:text-left border-l border-white/5 lg:border-none pl-4 lg:pl-0">
        <div class="text-xl lg:text-3xl xl:text-4xl font-black text-white">Free</div>
        <div class="text-[9px] lg:text-[10px] text-gray-500 uppercase tracking-[0.1em] lg:tracking-[0.2em] font-black leading-none">Biaya</div>
      </div>
    </div>
  </div>

  <!-- RIGHT SIDE: Image Slider Backdrop (Desktop: Right / Mobile: BOTTOM) -->
  <div class="relative w-full lg:flex-1 h-[35svh] lg:h-auto order-2 lg:order-2 overflow-hidden bg-black flex-shrink-0">
    <!-- Swiper container -->
    <div class="swiper hero-main-swiper absolute inset-0 w-full h-full">
      <div class="swiper-wrapper h-full">
        {slides.map((slide, index) => (
          <div class="swiper-slide cursor-grab active:cursor-grabbing h-full w-full">
            <img 
              src={slide.image.replace('w=2000', 'w=1200')} 
              alt={slide.title}
              class="w-full h-full object-cover select-none"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              width="1200"
              height="800"
            />
            <!-- Dark Overlay for Mobile readability and Desktop cinematic feel -->
            <div class="absolute inset-0 bg-black/40 lg:bg-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 lg:from-transparent via-transparent to-transparent"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- Navigation Overlay: Enhanced Visibility -->
    <div class="absolute bottom-6 md:bottom-10 right-1/2 lg:right-12 translate-x-1/2 lg:translate-x-0 z-40 flex items-center gap-4 bg-white/5 backdrop-blur-2xl p-3 lg:p-4 rounded-full border border-white/20 shadow-2xl">
      <div class="hero-pagination text-white text-[10px] md:text-xs font-black tracking-[0.2em] mr-2 md:mr-4 ml-2"></div>
      <button class="hero-prev flex-shrink-0 w-10 h-10 md:w-12 md:h-12 lg:w-14 lg:h-14 rounded-full bg-emerald-500 flex items-center justify-center text-white hover:bg-emerald-400 transition-all shadow-xl shadow-emerald-500/40 aspect-square">
        <svg class="w-4 h-4 md:w-5 md:h-5 lg:w-6 lg:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button class="hero-next flex-shrink-0 w-10 h-10 md:w-12 md:h-12 lg:w-14 lg:h-14 rounded-full bg-emerald-500 flex items-center justify-center text-white hover:bg-emerald-400 transition-all shadow-xl shadow-emerald-500/40 aspect-square">
        <svg class="w-4 h-4 md:w-5 md:h-5 lg:w-6 lg:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>


  <!-- Data for Client Script -->
  <script type="application/json" id="hero-data" set:html={JSON.stringify(slides)}></script>
</section>

<script>
  import { trackEvent } from '../../lib/analytics';
  
  const waBtn = document.getElementById('hero-whatsapp-btn');
  waBtn?.addEventListener('click', () => {
    trackEvent('click_whatsapp', 'Hero Main CTA');
  });
</script>

<script>
  import Swiper from 'swiper';
  import { Navigation, Autoplay, EffectFade, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/effect-fade';
  import 'swiper/css/pagination';

  // Data to sync
  // Data to sync (passed from server)
  const slides = JSON.parse(document.getElementById('hero-data').textContent);

  // DOM Elements
  const heroTitle = document.getElementById('hero-title');
  const heroTagline = document.getElementById('hero-tagline');
  const heroFeatures = document.getElementById('hero-features');

  const mainSwiper = new Swiper('.hero-main-swiper', {
    modules: [Navigation, Autoplay, EffectFade, Pagination],
    effect: 'fade',
    fadeEffect: { crossFade: true },
    autoplay: { delay: 6000, disableOnInteraction: false },
    speed: 1000,
    loop: true,
    navigation: {
      nextEl: '.hero-next',
      prevEl: '.hero-prev',
    },
    pagination: {
      el: '.hero-pagination',
      type: 'fraction',
      formatFractionCurrent: (n) => ('0' + n).slice(-2),
      formatFractionTotal: (n) => ('0' + n).slice(-2),
    },
    on: {
      slideChange: function () {
        const swiper = this as any;
        const index = swiper.realIndex;
        const currentData = slides[index];

        if (heroTitle && heroTagline && heroFeatures) {
          // Fade out content
          heroTitle.style.opacity = '0';
          heroTitle.style.transform = 'translateY(10px)';
          heroTagline.style.opacity = '0';
          heroFeatures.style.opacity = '0';

          setTimeout(() => {
            // Update content
            heroTitle.textContent = currentData.title;
            heroTagline.textContent = currentData.tagline;
            
            // Update features list
            heroFeatures.innerHTML = currentData.features.map(f => `
              <div class="flex items-center gap-3 text-gray-200">
                <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center">
                  <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-medium tracking-wide">${f}</span>
              </div>
            `).join('');

            // Fade in content
            heroTitle.style.opacity = '1';
            heroTitle.style.transform = 'translateY(0)';
            heroTagline.style.opacity = '1';
            heroFeatures.style.opacity = '1';
          }, 300);
        }
      }
    }
  });

  // Initial animation states
  if (heroTitle) {
    heroTitle.style.transition = 'all 0.5s ease';
    heroTagline!.style.transition = 'all 0.5s ease 0.1s';
    heroFeatures!.style.transition = 'all 0.5s ease 0.2s';
  }
</script>

<style>
  /* Custom line height and font weights for premium feel */
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }
  
  /* Ensure swiper pagination looks premium and bright */
  .hero-pagination {
    font-family: monospace;
    letter-spacing: 0.2em;
    color: #ffffff !important;
    font-weight: 900;
  }
  
  /* Force color for swiper fraction elements */
  :global(.hero-pagination) {
    color: #ffffff !important;
  }
</style>
