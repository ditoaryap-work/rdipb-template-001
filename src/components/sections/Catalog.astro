---
import { siteConfig } from '../../config/site.config';
import { getContent, getCollection } from '../../lib/content';

// Dynamic Header
const sectionData = getContent('sections/catalog') || {
  sectionTitle: "Pilih Hunian yang Sesaui Gaya Hidup Anda",
  sectionSubtitle: "Setiap desain dirancang untuk kenyamanan.",
  badge: "Collection 2024"
};

interface Unit {
  type: string;
  series?: string;
  price?: string;
  details?: string;
  image?: string;
  specs?: { lt?: number; lb?: number; kt?: number; km?: number };
  popular?: boolean;
}

// Load Units
const rawUnits = getCollection<Unit>('units');
const units = rawUnits.map(data => ({
  type: data.type ? data.type.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) : 'Unnamed Type',
  series: data.series || 'Standard Series',
  price: data.price || 'Hubungi Kami',
  details: data.details || '',
  image: data.image || 'https://images.unsplash.com/photo-1580587771525-78b9dba3b91d?q=80&w=1000&auto=format&fit=crop',
  specs: data.specs || { lt: 0, lb: 0, kt: 0, km: 0 },
  popular: data.popular || false,
}));
---


<section id="catalog" class="py-24 md:py-32 bg-white font-sans">
  <div class="container-custom">
    
    <!-- Header with better symmetry -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-20">
      <div class="max-w-xl">
        <span class="text-emerald-600 font-black text-xs uppercase tracking-[0.3em] mb-4 block">{sectionData.badge}</span>
        <h2 class="font-display text-4xl md:text-5xl font-black text-gray-900 leading-tight">
          {sectionData.sectionTitle}
        </h2>
      </div>
      <p class="text-gray-500 text-lg md:max-w-xs leading-relaxed">
        {sectionData.sectionSubtitle}
      </p>
    </div>

    <!-- Minimalist Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {units.length > 0 ? units.map((unit) => (
        <div class="group flex flex-col bg-white">
          
          <!-- Image Section with Integrated Specs & Popup -->
          <div 
            class="catalog-image-card relative aspect-[4/5] overflow-hidden rounded-[2.5rem] bg-gray-100 mb-8 border border-gray-100 shadow-sm group-hover:shadow-2xl transition-all duration-700 cursor-pointer"
            data-image={unit.image}
            data-title={unit.type}
          >
            <img 
              src={unit.image} 
              alt={unit.type}
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-110 transition duration-[1.5s] ease-out"
            />
            
            <!-- Darkened bottom for spec readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500"></div>

            <!-- Minimal Badge -->
            {unit.popular && (
              <div class="absolute top-6 left-6">
                <span class="px-5 py-2 bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest rounded-full shadow-lg">
                  Terpopuler
                </span>
              </div>
            )}

            <!-- Click to Zoom Indicator -->
            <div class="absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white border border-white/30">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
              </div>
            </div>

            <!-- Specs Overlay (Always visible on mobile, hover on desktop) -->
            <div class="absolute bottom-6 left-6 right-6">
              <div class="grid grid-cols-3 gap-3">
                <div class="flex flex-col items-center p-3 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 text-white transform lg:translate-y-4 lg:opacity-0 lg:group-hover:translate-y-0 lg:group-hover:opacity-100 transition-all duration-500 delay-[0ms]">
                  <svg class="w-4 h-4 mb-1 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                  <span class="text-xs font-black">{unit.specs?.lb} m²</span>
                  <span class="text-[7px] uppercase font-bold tracking-widest opacity-60">Bangunan</span>
                </div>
                <div class="flex flex-col items-center p-3 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 text-white transform lg:translate-y-4 lg:opacity-0 lg:group-hover:translate-y-0 lg:group-hover:opacity-100 transition-all duration-500 delay-[50ms]">
                  <svg class="w-4 h-4 mb-1 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                  <span class="text-xs font-black">{unit.specs?.lt} m²</span>
                  <span class="text-[7px] uppercase font-bold tracking-widest opacity-60">Tanah</span>
                </div>
                <div class="flex flex-col items-center p-3 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 text-white transform lg:translate-y-4 lg:opacity-0 lg:group-hover:translate-y-0 lg:group-hover:opacity-100 transition-all duration-500 delay-[100ms]">
                  <svg class="w-4 h-4 mb-1 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                  <span class="text-xs font-black">{unit.specs?.kt} KT</span>
                  <span class="text-[7px] uppercase font-bold tracking-widest opacity-60">Tidur</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Content Section -->
          <div class="px-2">
            <div class="flex flex-col xs:flex-row xs:items-center justify-between gap-y-1 mb-4">
              <span class="text-[10px] font-black text-emerald-600 uppercase tracking-widest">{unit.series}</span>
              <span class="text-xl font-black text-gray-900">{unit.price}</span>
            </div>
            
            <h3 class="text-3xl font-black text-gray-900 mb-8 group-hover:text-emerald-600 transition-colors">
              {unit.type}
            </h3>
            
            <!-- Premium WhatsApp Button -->
            <a 
              href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo, saya ingin menanyakan lebih detail tentang ${unit.type}`}
              target="_blank"
              class="inline-flex items-center gap-4 text-gray-900 font-black text-xs uppercase tracking-widest group/btn py-2 relative overflow-hidden"
            >
              <span>Detail & Konsultasi</span>
              <div class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center group-hover/btn:bg-emerald-500 group-hover/btn:border-emerald-500 group-hover/btn:text-white transition-all duration-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </div>
              <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gray-100 group-hover/btn:bg-emerald-500 transition-colors"></div>
            </a>
          </div>
        </div>
      )) : (
        <div class="col-span-3 text-center py-20 text-gray-400">
           Belum ada unit. Tambahkan lewat Admin Panel.
        </div>
      )}
    </div>
  </div>
</section>

<!-- Simple Lightbox Modal -->
<div id="catalog-modal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-black/95 backdrop-blur-lg modal-bg cursor-pointer"></div>
  <div class="absolute top-6 right-6 z-[110]">
    <button id="close-modal" class="w-12 h-12 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition-all border border-white/20">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div class="max-w-5xl w-full flex flex-col items-center gap-6 pointer-events-auto">
      <img id="modal-image" src="" alt="" class="max-h-[85svh] w-auto rounded-3xl shadow-2xl" />
      <h3 id="modal-title" class="text-white text-2xl font-black font-display"></h3>
    </div>
  </div>
</div>

<script>
  const cards = document.querySelectorAll('.catalog-image-card');
  const modal = document.getElementById('catalog-modal');
  const modalImg = document.getElementById('modal-image') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const closeBtn = document.getElementById('close-modal');
  const modalBg = document.querySelector('.modal-bg');

  function openModal(image, title) {
    if (modal && modalImg && modalTitle) {
      modalImg.src = image;
      modalTitle.textContent = title;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const img = card.getAttribute('data-image');
      const title = card.getAttribute('data-title');
      openModal(img, title);
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  modalBg?.addEventListener('click', closeModal);

  // Close on ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
