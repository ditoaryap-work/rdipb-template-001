---
import { getContent } from '../../lib/content';

const data = getContent('sections/location') || {
  sectionTitle: "Akses Mudah ke Mana Saja",
  sectionDescription: "Lokasi Strategis",
  mapEmbedUrl: "",
  transport: [],
  education: [],
  shopping: [],
  health: []
};

const pois = {
  transport: data.transport || [],
  education: data.education || [],
  shopping: data.shopping || [],
  health: data.health || []
};
---

<section id="location" class="py-24 bg-white">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left: Content -->
      <div>
        <span class="text-primary font-bold text-sm tracking-widest uppercase mb-2 block">Lokasi Strategis</span>
        <h2 class="section-title">{data.sectionTitle}</h2>
        <p class="section-subtitle !mx-0 mb-10 w-full text-justify">
          {data.sectionDescription}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <!-- Transport -->
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-gray-900 font-bold text-lg">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              </div>
              Transportasi
            </div>
            <ul class="space-y-2 pl-13">
              {pois.transport.map(item => (
                <li class="flex items-center gap-2 text-gray-600 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Education -->
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-gray-900 font-bold text-lg">
              <div class="w-10 h-10 rounded-full bg-orange-50 flex items-center justify-center text-orange-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              </div>
              Pendidikan
            </div>
            <ul class="space-y-2 pl-13">
              {pois.education.map(item => (
                <li class="flex items-center gap-2 text-gray-600 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-orange-200"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Shopping -->
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-gray-900 font-bold text-lg">
              <div class="w-10 h-10 rounded-full bg-pink-50 flex items-center justify-center text-pink-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
              </div>
              Belanja
            </div>
            <ul class="space-y-2 pl-13">
              {pois.shopping.map(item => (
                <li class="flex items-center gap-2 text-gray-600 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-pink-200"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Health -->
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-gray-900 font-bold text-lg">
              <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center text-emerald-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              </div>
              Kesehatan
            </div>
            <ul class="space-y-2 pl-13">
              {pois.health.map(item => (
                <li class="flex items-center gap-2 text-gray-600 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-200"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Right: Map -->
      <div class="relative h-[400px] lg:h-[500px] w-full bg-gray-100 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white/50 group">
         <iframe 
            src={data.mapEmbedUrl} 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="grayscale group-hover:grayscale-0 transition duration-700 ease-in-out"
          ></iframe>
          <div class="absolute inset-0 pointer-events-none ring-1 ring-black/5 rounded-[2.5rem]"></div>
      </div>
    </div>
  </div>
</section>
