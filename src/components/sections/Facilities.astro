---
import Section from '../ui/Section.astro';

const facilities = [
  {
    title: "Club House Eksklusif",
    description: "Nikmati sore yang santai bersama keluarga di club house modern.",
    image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=800&auto=format&fit=crop",
    class: "md:row-span-2 md:h-full"
  },
  {
    title: "Infinity Pool",
    description: "Kolam renang standar resort bintang lima.",
    image: "https://images.unsplash.com/photo-1576013551627-0cc20b96c2a7?q=80&w=800&auto=format&fit=crop",
    class: "md:col-span-1"
  },
  {
    title: "Jogging Track",
    description: "Jalur lari asri dikelilingi pepohonan rimbun.",
    image: "https://images.unsplash.com/photo-1552674605-469523170d73?q=80&w=800&auto=format&fit=crop",
    class: "md:col-span-1"
  }
];
---

<Section id="facilities" background="white">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-accent font-medium tracking-wide text-sm uppercase">Fasilitas Unggulan</span>
    <h2 class="text-3xl md:text-5xl font-serif font-bold text-slate-900 mt-4">
      Nikmati Hidup Berkualitas di Lingkungan Premium
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 h-auto md:h-[600px]">
    {facilities.map((item, index) => (
      <div class={`relative group overflow-hidden rounded-3xl ${item.class}`}>
        <img 
          src={item.image} 
          alt={item.title} 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent flex flex-col justify-end p-8">
          <h3 class="text-2xl font-bold text-white mb-2 translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
            {item.title}
          </h3>
          <p class="text-slate-300 opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-300 delay-75">
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</Section>
