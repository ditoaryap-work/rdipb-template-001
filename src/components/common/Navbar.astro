---
import { siteConfig } from '../../config/site.config';
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4" id="navbar">
  <div class="container-custom">
    <nav class="bg-[#18181b]/80 backdrop-blur-xl border border-white/5 shadow-lg rounded-2xl px-6 py-3 flex justify-between items-center relative z-50">
      <!-- Logo -->
      <a href="#hero" class="flex items-center gap-2 group">
        <div class="w-10 h-10 bg-emerald-500/10 rounded-xl flex items-center justify-center transition-transform group-hover:scale-110">
          <svg class="w-6 h-6 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
        </div>
        <span class="font-display font-bold text-xl tracking-tight text-gray-100 group-hover:text-emerald-400 transition-colors">
          Grand Avenue
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        <a href="#hero" class="px-4 py-2 text-sm font-medium text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 rounded-full transition-all">
          Beranda
        </a>
        <a href="#how-it-works" class="px-4 py-2 text-sm font-medium text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 rounded-full transition-all">
          Proses
        </a>
        <a href="#catalog" class="px-4 py-2 text-sm font-medium text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 rounded-full transition-all">
          Unit
        </a>
        <a href="#location" class="px-4 py-2 text-sm font-medium text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 rounded-full transition-all">
          Lokasi
        </a>
        
        <!-- Dropdown: Lainnya -->
        <div class="relative group" id="navbar-dropdown">
          <button class="px-4 py-2 text-sm font-medium text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 rounded-full transition-all flex items-center gap-1">
            Lainnya
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <div class="absolute top-[calc(100%+0.5rem)] right-0 w-48 bg-[#18181b]/95 backdrop-blur-xl border border-white/5 shadow-2xl rounded-2xl py-2 opacity-0 scale-95 invisible group-hover:opacity-100 group-hover:scale-100 group-hover:visible transition-all duration-300 origin-top-right">
            <a href="#kpr-calculator" class="block px-4 py-2 text-sm text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 transition-colors">
              Simulasi KPR
            </a>
            <a href="#faq" class="block px-4 py-2 text-sm text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 transition-colors">
              FAQ
            </a>
          </div>
        </div>
      </div>

      <!-- CTA & Mobile Menu -->
      <div class="flex items-center gap-3">
        <a 
          href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo, saya ingin info lebih lanjut`}
          target="_blank"
          class="hidden md:inline-flex items-center gap-2 px-6 py-2.5 bg-emerald-600 text-white rounded-full font-bold shadow-lg shadow-emerald-900/20 hover:shadow-xl hover:shadow-emerald-900/30 hover:bg-emerald-500 hover:-translate-y-0.5 transition-all text-sm"
          id="nav-whatsapp-btn"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <button 
          class="md:hidden p-2 text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/5 rounded-full transition-colors"
          aria-label="Toggle menu"
          id="mobile-menu-toggle"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div 
      id="mobile-menu" 
      class="md:hidden absolute top-24 left-4 right-4 bg-[#18181b]/95 backdrop-blur-xl border border-white/5 rounded-2xl shadow-xl overflow-hidden transition-all duration-300 origin-top opacity-0 scale-95 invisible"
    >
      <nav class="flex flex-col space-y-2 p-4">
        <a href="#hero" class="flex items-center p-3 rounded-xl hover:bg-emerald-500/10 text-gray-300 hover:text-emerald-400 font-medium">
          <span class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center mr-3 text-emerald-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </span>
          Beranda
        </a>
        <a href="#how-it-works" class="flex items-center p-3 rounded-xl hover:bg-emerald-500/10 text-gray-300 hover:text-emerald-400 font-medium">
          <span class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center mr-3 text-emerald-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </span>
          Proses
        </a>
        <a href="#catalog" class="flex items-center p-3 rounded-xl hover:bg-emerald-500/10 text-gray-300 hover:text-emerald-400 font-medium">
          <span class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center mr-3 text-emerald-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </span>
          Unit
        </a>
        <a href="#kpr" class="flex items-center p-3 rounded-xl hover:bg-emerald-500/10 text-gray-300 hover:text-emerald-400 font-medium">
          <span class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center mr-3 text-emerald-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.407 2.67 1M12 17c-1.12 0-2.09-.413-2.68-1m2-11V3m0 20v-2"/></svg>
          </span>
          KPR
        </a>
        <a href="#location" class="flex items-center p-3 rounded-xl hover:bg-emerald-500/10 text-gray-300 hover:text-emerald-400 font-medium">
          <span class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center mr-3 text-emerald-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </span>
          Lokasi
        </a>
        <a href="#faq" class="flex items-center p-3 rounded-xl hover:bg-emerald-500/10 text-gray-300 hover:text-emerald-400 font-medium">
          <span class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center mr-3 text-emerald-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </span>
          FAQ
        </a>
        <div class="h-px bg-white/10 my-2"></div>
        <a href="#contact" class="flex items-center p-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-medium justify-center transition-colors">
          Hubungi Kami
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Logic
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuLinks = document.querySelectorAll('a[href^="#"]'); // Select all anchor links
  const navbar = document.getElementById('navbar');

  function openMenu() {
    mobileMenu?.classList.remove('invisible', 'opacity-0', 'scale-95');
    mobileMenu?.classList.add('opacity-100', 'scale-100');
    document.body.style.overflow = 'hidden'; 
  }

  function closeMenu() {
    mobileMenu?.classList.add('invisible', 'opacity-0', 'scale-95');
    mobileMenu?.classList.remove('opacity-100', 'scale-100');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (mobileMenu?.classList.contains('invisible')) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  // Handle Smooth Scroll & Active State
  menuLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      // 1. Close mobile menu first
      if (window.innerWidth < 768) {
        closeMenu();
      }

      // 2. Smooth Scroll with Offset
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        const targetId = href.substring(1);
        const targetSection = document.getElementById(targetId);
        
        if (targetSection) {
          e.preventDefault(); // Stop default jump
          
          const navHeight = 80; // Approximate navbar height
          const targetPosition = targetSection.offsetTop - navHeight;

          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });

          // Optional: Update URL hash without jumping
          history.pushState(null, '', href);
        }
      }
    });
  });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (mobileMenu && !mobileMenu.classList.contains('invisible') && !mobileMenu.contains(target) && !toggleBtn?.contains(target)) {
      closeMenu();
    }
  });

  // Analytics
  import { trackEvent } from '../../lib/analytics';
  const navWaBtn = document.getElementById('nav-whatsapp-btn');
  navWaBtn?.addEventListener('click', () => {
    trackEvent('click_whatsapp', 'Navbar CTA');
  });
</script>
